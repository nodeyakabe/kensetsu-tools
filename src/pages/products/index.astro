---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faqReceive, faqPayment, faqBugSupport } from '@/data/faq-excerpts';
import { PRODUCT, ANZEN_DAICHO, KENSETSU_BANTO } from '@/data/product';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kensetsu-tools.com/" },
    { "@type": "ListItem", "position": 2, "name": "ツール・商品", "item": "https://kensetsu-tools.com/products/" },
  ],
};

const faqExcerpts = [faqReceive, faqBugSupport, faqPayment];

const timelineItems = [
  { label: '第1弾', date: '2026.5', note: '発売', released: true },
  { label: '第2弾', date: '2026.6', note: '発売', released: true },
  { label: '第3弾', date: '開発中',  note: '',     released: false },
  { label: '第4弾', date: '構想中',  note: '',     released: false },
];
---

<BaseLayout
  title="ツール・商品 | 建設業向け買い切りツール"
  description="一人親方・小規模建設業向けの買い切りツール一覧。Excel工事台帳「シンプル工事台帳」（¥5,980）、安全書類管理「シンプル安全台帳」（¥9,800）発売中。工事原価・資金繰り管理「建設番頭」（¥19,800）準備中。月額なし・完全買い切り。"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <style is:global>
    /* ===== 工房のお約束カード（既存流用） ===== */
    .promise-card { background: #F3F6FB; border-radius: 16px; padding: 26px 28px; display: flex; flex-direction: column; gap: 10px; }
    .promise-icon { width: 42px; height: 42px; background: #FFFFFF; border: 1px solid #D3DDEC; border-radius: 11px; color: #0F2557; font-weight: 900; font-size: 17px; display: flex; align-items: center; justify-content: center; }
    .promise-title { font-size: 15.5px; font-weight: 900; color: #0F2557; }
    .promise-body { font-size: 13px; line-height: 1.85; color: #5A6B85; }

    /* ===== 商品カード ===== */
    .prod-card {
      border: 1px solid #E3E8F0;
      border-radius: 18px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .prod-card-header {
      background: #0F2557;
      padding: 18px 24px;
    }
    .prod-card-body {
      padding: 22px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      flex: 1;
    }
    .prod-cta {
      display: block;
      width: 100%;
      background: #F59E0B;
      color: #FFFFFF;
      font-weight: 700;
      font-size: 15px;
      text-align: center;
      padding: 14px 0;
      border-radius: 10px;
      text-decoration: none;
      transition: background 0.15s;
      margin-top: auto;
    }
    .prod-cta:hover { background: #D98908; }

    /* ===== 選び方ガイド行 ===== */
    .guide-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      border: 1px solid #E3E8F0;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      background: #FAFBFD;
      transition: border-color 0.15s, background 0.15s;
    }
    .guide-row:hover { border-color: #B0BFDB; background: #F3F6FB; }

    /* ===== タイムライン（デスクトップ横型） ===== */
    .timeline-wrap { position: relative; display: flex; align-items: flex-start; }
    .timeline-line {
      position: absolute;
      top: 8px;
      left: calc(12.5%);
      right: calc(12.5%);
      height: 2px;
      background: #D8DEE8;
    }
    .timeline-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      position: relative;
    }
    .tl-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2.5px solid #0F2557;
      z-index: 1;
      flex-shrink: 0;
    }
    .tl-dot.released { background: #0F2557; }
    .tl-dot.upcoming { background: #FFFFFF; }
    .tl-label { font-size: 13px; font-weight: 900; color: #0F2557; text-align: center; }
    .tl-date  { font-size: 13px; font-weight: 700; color: #44536E; text-align: center; }
    .tl-note  { font-size: 11.5px; color: #F59E0B; font-weight: 700; text-align: center; min-height: 16px; }

    /* ===== タイムライン（スマホ縦型） ===== */
    .timeline-v { display: none; flex-direction: column; position: relative; padding-left: 36px; }
    .timeline-v-line {
      position: absolute;
      left: 8px;
      top: 9px;
      bottom: 9px;
      width: 2px;
      background: #D8DEE8;
    }
    .tl-v-item { position: relative; padding-bottom: 22px; display: flex; flex-direction: column; gap: 2px; }
    .tl-v-item:last-child { padding-bottom: 0; }
    .tl-v-dot {
      position: absolute;
      left: -32px;
      top: 3px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 2.5px solid #0F2557;
      z-index: 1;
    }
    .tl-v-dot.released { background: #0F2557; }
    .tl-v-dot.upcoming { background: #FFFFFF; }

    /* ===== 比較表 ===== */
    .cmp-table-wrap { overflow: visible; }
    .cmp-table { width: 100%; border-collapse: collapse; font-size: 16px; }
    .cmp-table th, .cmp-table td { padding: 13px 18px; text-align: left; border-bottom: 1px solid #E3E8F0; }
    .cmp-table thead th { font-weight: 700; color: #5A6B85; background: #F3F6FB; }
    .cmp-table tbody th { font-weight: 700; color: #44536E; width: 120px; }
    .cmp-table td { color: #1A2B4A; }

    /* ===== FAQ抜粋アコーディオン ===== */
    .prd-faq-answer { overflow: hidden; }
    .prd-faq-chevron { transition: transform 0.2s; }

    /* ===== CTA ===== */
    .btn-cta { background: #F59E0B; color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 15px; padding: 15px 34px; border-radius: 8px; transition: background 0.15s; white-space: nowrap; flex: none; }
    .btn-cta:hover { background: #D98908; }

    /* ===== レスポンシブ ===== */
    .products-hero-inner { max-width: 1180px; margin: 0 auto; padding: 26px 40px 28px; display: flex; flex-direction: column; gap: 12px; }
    .products-inner   { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
    .products-inner-w { max-width: 1180px; margin: 0 auto; padding: 0 40px; }
    .prod-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .cta-inner { max-width: 1180px; margin: 0 auto; padding: 56px 40px; display: flex; align-items: center; gap: 32px; }

    .cmp-cards { display: none; }

    @media (max-width: 767px) {
      .products-hero-inner { padding: 20px 20px 22px; }
      .products-inner   { padding: 0 16px; }
      .products-inner-w { padding: 0 16px; }
      .prod-grid { grid-template-columns: 1fr; }
      .promise-grid { grid-template-columns: 1fr; }
      .cta-inner { flex-direction: column; align-items: flex-start; padding: 40px 20px; gap: 20px; }
      /* タイムライン切り替え */
      .timeline-wrap, .timeline-line { display: none; }
      .timeline-v { display: flex; }
      /* 比較表切り替え */
      .cmp-table-wrap { display: none; }
      .cmp-cards { display: flex; flex-direction: column; gap: 12px; }
    }
  </style>

  <!-- パンくず -->
  <div class="w-full px-4 sm:px-6 lg:px-10 py-3 bg-white border-b border-slate-100">
    <nav class="text-sm text-slate-500" aria-label="パンくずリスト">
      <a href="/" class="hover:text-[#0F2557] transition-colors">ホーム</a>
      <span class="mx-2">/</span>
      <span class="text-[#1A2B4A]">ツール・商品</span>
    </nav>
  </div>

  <!-- S1: ヒーロー（圧縮） -->
  <section style="background: #0F2557; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -180px; right: -220px; width: 620px; height: 620px; border: 76px solid #14305F; border-radius: 50%;"></div>
    <div class="products-hero-inner">
      <div style="border: 1.5px solid rgba(255,255,255,0.5); color: #FFFFFF; font-size: 12px; font-weight: 700; padding: 7px 22px; border-radius: 999px; width: fit-content;">PRODUCTS — ツール・商品</div>
      <h1 style="margin: 0; font-size: 48px; font-weight: 900; color: #FFFFFF; letter-spacing: 0.04em;">ツール・商品</h1>
      <div style="display: flex; flex-direction: column; gap: 6px; max-width: 600px;">
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #FFFFFF; font-weight: 700;">建設業の現場で本当に使えるツールを、買い切りでお届けします。</p>
        <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #C7D2E5;">月額なし・むずかしい操作なし。ITが苦手な方でも、今日から使えます。</p>
      </div>
    </div>
  </section>

  <!-- 白の曲面立ち上がり -->
  <div style="background: #FFFFFF; border-radius: 52px 52px 0 0; margin-top: -28px; position: relative;">

    <!-- S2: 選び方ガイド -->
    <div style="padding: 44px 0 0;">
      <div class="products-inner">
        <div style="background: #FFFFFF; border: 1px solid #E3E8F0; border-radius: 16px; padding: 24px 28px; display: flex; flex-direction: column; gap: 14px;">
          <p style="margin: 0; font-size: 13px; font-weight: 700; color: #F59E0B; letter-spacing: 0.06em;">GUIDE — どちらを選べばいい？</p>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <a href="#koji" class="guide-row">
              <span style="color: #F59E0B; font-weight: 900; font-size: 16px; flex: none;">→</span>
              <span style="font-size: 16px; color: #44536E; flex: 1; line-height: 1.6;">お金の記録・確定申告をラクにしたい</span>
              <span style="font-size: 13.5px; font-weight: 700; color: #0F2557; flex: none;">シンプル工事台帳</span>
            </a>
            <a href="#anzen" class="guide-row">
              <span style="color: #F59E0B; font-weight: 900; font-size: 16px; flex: none;">→</span>
              <span style="font-size: 16px; color: #44536E; flex: 1; line-height: 1.6;">資格・車検の期限管理と書類づくり</span>
              <span style="font-size: 13.5px; font-weight: 700; color: #0F2557; flex: none;">シンプル安全台帳</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- S3: 発売中のツール -->
    <div style="padding: 44px 0 0;">
      <div class="products-inner">
        <!-- セクション見出し -->
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="width: 5px; height: 22px; background: #F59E0B; border-radius: 2px;"></div>
          <h2 style="margin: 0; font-size: 19px; font-weight: 900; color: #0F2557; letter-spacing: 0.04em;">発売中のツール</h2>
        </div>
        <!-- 2カラムグリッド -->
        <div class="prod-grid">

          <!-- 工事台帳カード -->
          <div id="koji" class="prod-card">
            <div class="prod-card-header">
              <div style="font-size: 12px; color: #8FA1C4; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 4px;">第1弾・発売中</div>
              <h3 style="margin: 0; font-size: 20px; font-weight: 900; color: #FFFFFF;">シンプル工事台帳</h3>
            </div>
            <div class="prod-card-body">
              <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #44536E;">入金と支出を入れるだけで、収支と確定申告用の集計ができるExcelツール</p>
              <div>
                <div style="font-size: 28px; font-weight: 900; color: #0F2557; line-height: 1;">¥{PRODUCT.price.toLocaleString()}</div>
                <div style="font-size: 12px; color: #8FA1C4; margin-top: 2px;">買い切り・月額なし</div>
              </div>
              <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px;">
                <li style="font-size: 16px; color: #1A2B4A; display: flex; gap: 8px; line-height: 1.6;">
                  <span style="color: #11512F; font-weight: 700; flex: none;">✓</span>
                  マクロなし・Excelだけで動く
                </li>
                <li style="font-size: 16px; color: #1A2B4A; display: flex; gap: 8px; line-height: 1.6;">
                  <span style="color: #11512F; font-weight: 700; flex: none;">✓</span>
                  確定申告サマリー自動集計
                </li>
              </ul>
              <a href="/products/koji-daicho/" class="prod-cta">詳細・購入へ →</a>
            </div>
          </div>

          <!-- 安全台帳カード -->
          <div id="anzen" class="prod-card">
            <div class="prod-card-header">
              <div style="font-size: 12px; color: #8FA1C4; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 4px;">第2弾・発売中</div>
              <h3 style="margin: 0; font-size: 20px; font-weight: 900; color: #FFFFFF;">シンプル安全台帳</h3>
            </div>
            <div class="prod-card-body">
              <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #44536E;">資格・車検の期限を一覧管理し、作業員名簿などの書類PDFまで出力</p>
              <div>
                <div style="font-size: 28px; font-weight: 900; color: #0F2557; line-height: 1;">¥{ANZEN_DAICHO.price.toLocaleString()}</div>
                <div style="font-size: 12px; color: #8FA1C4; margin-top: 2px;">買い切り・月額なし</div>
              </div>
              <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px;">
                <li style="font-size: 16px; color: #1A2B4A; display: flex; gap: 8px; line-height: 1.6;">
                  <span style="color: #11512F; font-weight: 700; flex: none;">✓</span>
                  期限切れ・30日以内を自動で警告
                </li>
                <li style="font-size: 16px; color: #1A2B4A; display: flex; gap: 8px; line-height: 1.6;">
                  <span style="color: #11512F; font-weight: 700; flex: none;">✓</span>
                  完全オフライン・データは手元に
                </li>
              </ul>
              <a href="/products/anzen-daicho/" class="prod-cta">詳細・購入へ →</a>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- S4: これからのツール -->
    <div style="margin-top: 48px; background: #F3F6FB; padding: 40px 0;">
      <div class="products-inner">
        <!-- セクション見出し -->
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="width: 5px; height: 22px; background: #D8DEE8; border-radius: 2px;"></div>
          <h2 style="margin: 0; font-size: 19px; font-weight: 900; color: #0F2557; letter-spacing: 0.04em;">これからのツール</h2>
        </div>
        <!-- 建設番頭スリム行 -->
        <div style="background: #FFFFFF; border: 1px solid #E3E8F0; border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <span style="background: #E5E7EB; color: #6B7280; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; flex: none;">開発中</span>
          <span style="font-size: 15px; font-weight: 900; color: #0F2557;">建設番頭</span>
          <span style="font-size: 16px; color: #5A6B85; line-height: 1.6;">— 原価と資金繰りの見える化（第3弾）</span>
          <span style="margin-left: auto; font-size: 14px; color: #8FA1C4; flex: none;">¥{KENSETSU_BANTO.price.toLocaleString()} 予定</span>
          <a href="/products/kensetsu-banto/" style="font-size: 14px; color: #0F2557; font-weight: 700; text-decoration: underline; flex: none;">詳しく見る →</a>
        </div>

        <!-- タイムライン（デスクトップ横型） -->
        <div style="margin-top: 32px; position: relative;">
          <div class="timeline-wrap">
            <div class="timeline-line"></div>
            {timelineItems.map(item => (
              <div class="timeline-item">
                <div class={`tl-dot ${item.released ? 'released' : 'upcoming'}`}></div>
                <div class="tl-label">{item.label}</div>
                <div class="tl-date">{item.date}</div>
                <div class="tl-note">{item.note}</div>
              </div>
            ))}
          </div>

          <!-- タイムライン（スマホ縦型） -->
          <div class="timeline-v">
            <div class="timeline-v-line"></div>
            {timelineItems.map(item => (
              <div class="tl-v-item">
                <div class={`tl-v-dot ${item.released ? 'released' : 'upcoming'}`}></div>
                <div style="font-size: 13px; font-weight: 900; color: #0F2557;">{item.label} <span style="font-weight: 700; color: #44536E;">{item.date}</span>{item.note && <span style="color: #F59E0B; font-weight: 700; margin-left: 6px;">{item.note}</span>}</div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- S5: 2つのツールの違い（比較表） -->
    <div style="padding: 48px 0 0;">
      <div class="products-inner">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="width: 5px; height: 22px; background: #F59E0B; border-radius: 2px;"></div>
          <h2 style="margin: 0; font-size: 19px; font-weight: 900; color: #0F2557; letter-spacing: 0.04em;">2つのツールの違い</h2>
        </div>

        <!-- デスクトップ：テーブル -->
        <div class="cmp-table-wrap">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col" style="color: #0F2557;">シンプル工事台帳</th>
                <th scope="col" style="color: #0F2557;">シンプル安全台帳</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">用途</th>
                <td>お金の記録・申告準備</td>
                <td>期限管理・安全書類</td>
              </tr>
              <tr>
                <th scope="row">形式</th>
                <td>Excel（Windows / Mac）</td>
                <td>Windows アプリ</td>
              </tr>
              <tr>
                <th scope="row">価格</th>
                <td>¥{PRODUCT.price.toLocaleString()}（買い切り）</td>
                <td>¥{ANZEN_DAICHO.price.toLocaleString()}（買い切り）</td>
              </tr>
              <tr>
                <th scope="row" style="border-bottom: none;">こんな方に</th>
                <td style="border-bottom: none;">確定申告を自力でやる一人親方</td>
                <td style="border-bottom: none;">元請に書類を出す現場がある方</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- モバイル：2枚カード縦積み -->
        <div class="cmp-cards">
          {[
            { name: 'シンプル工事台帳', href: '/products/koji-daicho/', rows: [
              ['用途', 'お金の記録・申告準備'],
              ['形式', 'Excel（Windows / Mac）'],
              ['価格', `¥${PRODUCT.price.toLocaleString()}（買い切り）`],
              ['こんな方に', '確定申告を自力でやる一人親方'],
            ]},
            { name: 'シンプル安全台帳', href: '/products/anzen-daicho/', rows: [
              ['用途', '期限管理・安全書類'],
              ['形式', 'Windows アプリ'],
              ['価格', `¥${ANZEN_DAICHO.price.toLocaleString()}（買い切り）`],
              ['こんな方に', '元請に書類を出す現場がある方'],
            ]},
          ].map(card => (
            <div style="border: 1px solid #E3E8F0; border-radius: 14px; overflow: hidden;">
              <div style="background: #0F2557; padding: 12px 16px;">
                <p style="margin: 0; font-size: 14px; font-weight: 900; color: #FFFFFF;">{card.name}</p>
              </div>
              <div>
                {card.rows.map(([label, val]) => (
                  <div style="display: flex; gap: 0; border-bottom: 1px solid #F0F3F8;">
                    <div style="font-size: 12px; font-weight: 700; color: #5A6B85; background: #F7F8FC; padding: 10px 14px; width: 96px; flex: none;">{label}</div>
                    <div style="font-size: 16px; color: #1A2B4A; padding: 10px 14px; line-height: 1.6;">{val}</div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- S6: よくある質問（抜粋） -->
    <div style="padding: 48px 0 0;">
      <div class="products-inner">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="width: 5px; height: 22px; background: #F59E0B; border-radius: 2px;"></div>
          <h2 style="margin: 0; font-size: 19px; font-weight: 900; color: #0F2557; letter-spacing: 0.04em;">よくある質問</h2>
        </div>
        <dl style="display: flex; flex-direction: column; gap: 10px;">
          {faqExcerpts.map((faq, i) => {
            const uid = String(i);
            return (
              <div style="border: 1px solid #D8DEE8; border-radius: 16px; overflow: hidden;">
                <dt>
                  <button
                    class="w-full flex items-start justify-between gap-4 px-6 py-4 text-left font-bold text-[#1A2B4A] hover:bg-[#EFF2F7] transition-colors"
                    style="min-height: 44px;"
                    aria-expanded="false"
                    aria-controls={`prd-faq-answer-${uid}`}
                    id={`prd-faq-btn-${uid}`}
                  >
                    <span style="display: flex; gap: 10px; align-items: flex-start;">
                      <span style="color: #F59E0B; font-weight: 900; font-size: 13px; margin-top: 1px; flex: none;">Q</span>
                      <span style="font-size: 16px; line-height: 1.6;">{faq.q}</span>
                    </span>
                    <svg class="prd-faq-chevron flex-shrink-0 w-5 h-5 text-[#5A6B85] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>
                </dt>
                <dd
                  id={`prd-faq-answer-${uid}`}
                  role="region"
                  aria-labelledby={`prd-faq-btn-${uid}`}
                  class="prd-faq-answer hidden px-6 pb-5 text-[#44536E]"
                >
                  <div style="display: flex; gap: 10px; align-items: flex-start; padding-top: 14px; border-top: 1px solid #D8DEE8;">
                    <span style="color: #0F2557; font-weight: 900; font-size: 13px; margin-top: 1px; flex: none;">A</span>
                    <span style="font-size: 16px; line-height: 1.7;" set:html={faq.a} />
                  </div>
                </dd>
              </div>
            );
          })}
        </dl>
        <div style="margin-top: 16px; text-align: right;">
          <a href="/faq/" style="font-size: 13.5px; color: #0F2557; font-weight: 700; text-decoration: underline;">よくある質問をすべて見る →</a>
        </div>
      </div>
    </div>

    <!-- S7: 工房のお約束（既存流用） -->
    <div style="padding: 48px 0 64px;">
      <div class="products-inner-w" style="padding-top: 0;">
        <div style="border-top: 1px solid #E3E8F0; padding-top: 44px; display: flex; flex-direction: column; gap: 22px;">
          <div style="display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;">
            <div style="border: 1.5px solid #0F2557; color: #0F2557; font-size: 12px; font-weight: 700; padding: 7px 22px; border-radius: 999px;">PROMISE — 工房のお約束</div>
            <h2 style="margin: 0; font-size: 22px; font-weight: 900; color: #0F2557; letter-spacing: 0.04em;">どのツールにも、共通すること</h2>
          </div>
          <div class="promise-grid">
            <div class="promise-card">
              <div class="promise-icon">¥</div>
              <div class="promise-title">買い切り・月額なし</div>
              <div class="promise-body">一度のお支払いで、ずっと使えます。更新料や追加費用はいただきません。</div>
            </div>
            <div class="promise-card">
              <div class="promise-icon">✓</div>
              <div class="promise-title">説明書いらずの設計</div>
              <div class="promise-body">ITが苦手な方を基準に、開いたその日から迷わず使えるようにしています。</div>
            </div>
            <div class="promise-card">
              <div class="promise-icon" style="font-size: 13px;">PC</div>
              <div class="promise-title">データはお手元に</div>
              <div class="promise-body">クラウド送信なし。あなたのPCの中だけで完結します。</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /白の曲面立ち上がり -->

  <!-- S8: CTA（既存流用） -->
  <section style="background: #0F2557;">
    <div class="cta-inner">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <h2 style="margin: 0; font-size: 24px; font-weight: 900; color: #FFFFFF; letter-spacing: 0.04em;">ご質問・ご要望をお聞かせください</h2>
        <p style="margin: 0; font-size: 13.5px; line-height: 1.9; color: #C7D2E5;">購入前のご不明点も、お気軽にお問い合わせください。</p>
      </div>
      <a href="/contact/" class="btn-cta" style="margin-left: auto;">お問い合わせフォームへ</a>
    </div>
  </section>

</BaseLayout>

<script>
  function initPrdFaq() {
    document.querySelectorAll<HTMLButtonElement>('[id^="prd-faq-btn-"]').forEach(btn => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const answer = document.getElementById(btn.getAttribute('aria-controls')!)!;
        const chevron = btn.querySelector('.prd-faq-chevron')!;
        btn.setAttribute('aria-expanded', String(!expanded));
        answer.classList.toggle('hidden', expanded);
        chevron.classList.toggle('rotate-180', !expanded);
      });
    });
  }
  initPrdFaq();
  document.addEventListener('astro:page-load', initPrdFaq);
</script>
